{
  "name": "worldtree",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:python": "python scripts/test_python.py",
    "data:import": "python scripts/import_ecoregions.py",
    "build:worker": "esbuild src/lib/geo.worker.ts --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=public/geo-worker.js && node scripts/copy-map-worker.mjs",
    "prebuild": "npm run build:worker",
    "predev": "npm run build:worker",
    "preview:local": "node scripts/preview.mjs",
    "pretest": "npm run build:worker",
    "data:global": "python scripts/import_global_catalog.py && tsx scripts/audit-coverage.ts",
    "coverage": "tsx scripts/audit-coverage.ts"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.3.0",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
