      "family": "rainforest",
      "severity": "major",
      "evidence": "Native regional candidates and layered floor/stand render in three continents. Tree height and crown shapes remain uneven; many species use generic branching, with a visible finite stand footprint from above.",
      "decision": "Retain experiment; not concept-quality or species-accurate approval."
    },
    {
      "family": "tropicalpine",
      "severity": "major",
      "evidence": "Open raised-crown conifer forms and needle-textured floor are readable. Generic trunks and repeated bough structure remain; identities are deliberately unnamed because the eligible candidate pool is empty.",
      "decision": "Retain functional-form previews. Named profiles and stronger regional evidence are required before botanical promotion."
    },
    {
      "family": "conifer",
      "severity": "major",
      "evidence": "Regional genus-conditioned trees retain enclosed forest character. Boreal floor/palette borrowing and limited distant stand coverage remain evident.",
      "decision": "Retain preview; preserve original Puget reference as the accepted artwork."
    },
    {
      "family": "savanna",
      "severity": "major",
      "evidence": "Expansive open grassland, terrain continuation and dimensional cover transfer. Regional woody communities, species-appropriate foreground variation and stronger middle-distance anchors are missing.",
      "decision": "Open-patch trials only; do not infer categorical treelessness or regional completeness."
    },
    {
      "family": "flooded",
      "severity": "major",
      "evidence": "Irregular water/land mosaic and sky-reflected water remain visible at encounter height. Broad pale foregrounds and sparse silhouette diversity remain; local hydroperiod and tree islands are not established.",
      "decision": "Retain unreviewed wetland trials; no fixed water tint was introduced."
    },
    {
      "family": "montane",
      "severity": "major",
      "evidence": "Tussocks, cushions and embedded rocks transfer without named Andean woody/rosette roles. Foreign distant peaks are withheld, exposing weak atmospheric continuation and repetitive cover.",
      "decision": "Retain functional montane trials; region-compatible background/evidence remains necessary."
    },
    {
      "family": "mediterranean",
      "severity": "major",
      "evidence": "Supported cork/holm oak candidates preserve foreground framing and winding soil openings. Without the Hérault matte, foreign backgrounds are flatter and less intricate; shrubs/flowers remain approximate.",
      "decision": "Retain trial; no approval of regional surface/geological fidelity."
    },
    {
      "family": "desert",
      "severity": "major",
      "evidence": "Open horizon, large rock anchors, sparse vegetation and soil texture transfer. Repetitive geological molds and mechanical large-scale ground patterns remain visible, especially from elevated views.",
      "decision": "Retain rockland studies, not actual surveyed Atacama/Namib land cover."
    }
